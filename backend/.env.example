# --- Base de données -------------------------------------------------------
# SQLite en local (par défaut, aucune installation requise) :
DATABASE_URL=sqlite:///./app.db
# PostgreSQL (utilisé automatiquement par docker-compose) :
# DATABASE_URL=postgresql://dashboard:dashboard@postgres:5432/dashboard

# --- Sécurité ---------------------------------------------------------------
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Assistant IA -------------------------------------------------------
# "mock" fonctionne sans aucune clé (par défaut). "openai" ou "anthropic"
# activent le vrai fournisseur si une clé est renseignée ci-dessous.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- CORS ---------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
